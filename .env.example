# Free mode is the default. No API key or model credits are needed.
RESEARCH_MODE=docs
RESEARCH_MAX_PAGES=8
# Optional model mode: explicitly set RESEARCH_MODE=openai and configure a key.
# Local Cloudflare bindings read these from .dev.vars.
# Copy this file to .dev.vars and set secrets in your editor or secret manager.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
RESEARCH_TIMEOUT_MS=45000
RESEARCH_MAX_SEARCH_CALLS=8
RESEARCH_MAX_SOURCES=12
RESEARCH_MAX_OUTPUT_TOKENS=9000
